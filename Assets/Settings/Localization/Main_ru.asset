  - m_Id: 6028775585210391
    m_Localized: "<style=\"rare\">\u0417\u043E\u043B\u043E\u0442\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775585210392
    m_Localized: "<style=\"epic\">\u041F\u043E\u043A\u0440\u044B\u0442\u0438\u0435
      \u0438\u0437 \u0434\u0440\u0435\u0432\u043E\u0446\u0432\u0435\u0442\u043A\u0430</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775585210393
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u043D\u0430 <style=\"number\">1</style> \u0442\u0430\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598976
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u043D\u0430 <style=\"number\">2</style> \u0442\u0430\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598977
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u043D\u0430 <style=\"number\">4</style> \u0442\u0430\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598978
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438
      \u043D\u0430 <style=\"number\">5%</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598979
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438
      \u043D\u0430 <style=\"number\">15%</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598980
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438
      \u043D\u0430 <style=\"number\">25%</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598981
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C
      <style=\"rare\">\u0440\u0435\u0434\u043A\u0438\u0435</style> \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598982
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C
      <style=\"epic\">\u044D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0435</style>
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598983
    m_Localized: "\u0417\u0430\u0431\u044B\u0442\u044B\u0435 \u043F\u0435\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598984
    m_Localized: "\u0412\u043E\u0434\u043E\u043F\u0430\u0434\u044B \u043D\u0430\u0434\u0435\u0436\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598985
    m_Localized: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598986
    m_Localized: "\u0417\u0430\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598987
    m_Localized: "\u041E\u0441\u0442\u0440\u044B\u0435 \u0448\u0438\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598988
    m_Localized: "\u041D\u0435\u0447\u0442\u043E \u0438\u0437 \u0433\u043B\u0443\u0431\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598989
    m_Localized: "\u041F\u0443\u0442\u044C \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442
      \u0437\u0430\u0432\u0430\u043B. \u041E\u0431\u0445\u043E\u0434\u043D\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u043D\u0435\u0442. \u041A\u0430\u043A \u0435\u0433\u043E
      \u0443\u0431\u0440\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598990
    m_Localized: "\u041F\u043E\u043A\u0430 \u0442\u044B \u043B\u044E\u0431\u043E\u0432\u0430\u043B\u0441\u044F
      \u0432\u0438\u0434\u0430\u043C\u0438, \u0442\u044B \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B,
      \u043A\u0430\u043A \u043F\u043E\u0434 \u0442\u043E\u0431\u043E\u0439 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0448\u0438\u043F\u044B. \u041D\u0443\u0436\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0441\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598991
    m_Localized: "\u0422\u044B \u0432\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u0441\u044F
      \u0432 \u0442\u044C\u043C\u0443, \u043A\u0430\u043A \u0432\u0434\u0440\u0443\u0433
      \u043E\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0432 \u043E\u0442\u0432\u0435\u0442. \u042D\u0442\u0430 \u0442\u044C\u043C\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
      \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598992
    m_Localized: "\u041C\u043D\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043D\u0443\u0436\u043D\u043E, \u044F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E
      \u043F\u043D\u0443\u0442\u044C \u043D\u043E\u0433\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598993
    m_Localized: "\u041A\u0438\u043D\u0443 \u0432 \u0441\u043B\u0430\u0431\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u0437\u0430\u0432\u0430\u043B\u0430 3 \u043A\u0443\u0441\u043A\u0430
      \u0436\u0435\u043B\u0435\u0437\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598994
    m_Localized: "\u041A\u0438\u043D\u0443 \u0432 \u0441\u043B\u0430\u0431\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u0437\u0430\u0432\u0430\u043B\u0430 2 \u043A\u0443\u0441\u043A\u0430
      \u0437\u043E\u043B\u043E\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598995
    m_Localized: "\u0422\u044B \u0442\u0430\u043A \u043D\u0435\u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u0443\u0434\u0430\u0440\u0438\u043B\u0441\u044F \u043D\u043E\u0433\u043E\u0439
      \u043E \u0437\u0430\u0432\u0430\u043B, \u0447\u0442\u043E \u0438\u0437 \u043C\u0435\u0448\u043A\u0430
      \u0432\u044B\u043F\u0430\u043B\u0430 \u0447\u0430\u0441\u0442\u044C \u043C\u043E\u043D\u0435\u0442.
      \u041D\u043E \u0437\u0430\u0432\u0430\u043B \u0438\u0441\u0447\u0435\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598996
    m_Localized: "\u0422\u0435\u0431\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043F\u044B\u0442\u043E\u043A,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0437\u0430\u0432\u0430\u043B
      \u0438\u0441\u0447\u0435\u0437, \u043E\u0442\u043A\u0440\u044B\u0432 \u043F\u0440\u043E\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598997
    m_Localized: "\u0422\u0435\u0431\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043F\u044B\u0442\u043E\u043A,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0437\u0430\u0432\u0430\u043B
      \u0438\u0441\u0447\u0435\u0437, \u043E\u0442\u043A\u0440\u044B\u0432 \u043F\u0440\u043E\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6028775593598998
    m_Localized: null
