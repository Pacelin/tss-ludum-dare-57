      m_Items: []
  - m_Id: 6026414426939416
    m_Localized: "<style=\"epic\">\u041F\u043E\u043A\u0440\u044B\u0442\u0438\u0435
      \u0438\u0437 \u0434\u0440\u0435\u0432\u043E\u0446\u0432\u0435\u0442\u043A\u0430</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939417
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u043D\u0430 <style=\"number\">1</style> \u0442\u0430\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939418
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u043D\u0430 <style=\"number\">2</style> \u0442\u0430\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939419
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u043D\u0430 <style=\"number\">4</style> \u0442\u0430\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939420
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438
      \u043D\u0430 <style=\"number\">5%</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939421
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438
      \u043D\u0430 <style=\"number\">15%</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939422
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438
      \u043D\u0430 <style=\"number\">25%</style>"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939423
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C
      <style=\"rare\">\u0440\u0435\u0434\u043A\u0438\u0435</style> \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939424
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C
      <style=\"epic\">\u044D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0435</style>
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939425
    m_Localized: "\u0417\u0430\u0431\u044B\u0442\u044B\u0435 \u043F\u0435\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939426
    m_Localized: "\u0412\u043E\u0434\u043E\u043F\u0430\u0434\u044B \u043D\u0430\u0434\u0435\u0436\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939427
    m_Localized: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939428
    m_Localized: "\u0417\u0430\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939429
    m_Localized: "\u041E\u0441\u0442\u0440\u044B\u0435 \u0448\u0438\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939430
    m_Localized: "\u041D\u0435\u0447\u0442\u043E \u0438\u0437 \u0433\u043B\u0443\u0431\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939431
    m_Localized: "\u041F\u0443\u0442\u044C \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442
      \u0437\u0430\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939432
    m_Localized: "\u041F\u043E\u043A\u0430 \u0442\u044B \u043B\u044E\u0431\u043E\u0432\u0430\u043B\u0441\u044F
      \u0432\u0438\u0434\u0430\u043C\u0438, \u0442\u044B \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B,
      \u043A\u0430\u043A \u043F\u043E\u0434 \u0442\u043E\u0431\u043E\u0439 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0448\u0438\u043F\u044B. \u041D\u0443\u0436\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0441\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6026414426939433
    m_Localized: "\u0422\u044B \u0432\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u0441\u044F
      \u0432 \u0442\u044C\u043C\u0443, \u043A\u0430\u043A \u0432\u0434\u0440\u0443\u0433
      \u043E\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0432 \u043E\u0442\u0432\u0435\u0442. \u042D\u0442\u0430 \u0442\u044C\u043C\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
